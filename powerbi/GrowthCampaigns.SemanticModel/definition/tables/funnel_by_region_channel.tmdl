/// funnel counts with 7-day windows, region x channel (SIMULATED)
table funnel_by_region_channel
	lineageTag: 01615ecb-7513-56b2-b318-e50d06136e4e

	column region
		dataType: string
		lineageTag: 069a56cb-18a6-5228-9e77-74f75541e659
		summarizeBy: none
		sourceColumn: region

	column channel
		dataType: string
		lineageTag: c3643429-9e13-5052-8ea0-942e3fa6961f
		summarizeBy: none
		sourceColumn: channel

	column registrations
		dataType: int64
		lineageTag: 56f03dd5-2a9f-53ed-bb6a-71de836863bc
