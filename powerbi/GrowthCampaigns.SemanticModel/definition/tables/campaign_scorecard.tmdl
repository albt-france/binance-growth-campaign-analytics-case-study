	column media_usd
		dataType: double
		lineageTag: e7c434da-a1b4-5815-ac32-d7fd7f0cd406
		summarizeBy: none
		sourceColumn: media_usd

	column promo_usd
		dataType: double
		lineageTag: bd6eab70-8432-56b6-9130-66e0ff1e6099
		summarizeBy: none
		sourceColumn: promo_usd

	column cac_first_deposit
		dataType: double
		lineageTag: 0a950007-c4f9-54e8-8751-022183622dc7
