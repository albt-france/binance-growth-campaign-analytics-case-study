/// one row per simulated campaign: attributed KPIs, incremental estimates, status (SIMULATED)
table campaign_scorecard
	lineageTag: 0579cb36-5994-5262-927d-df984a52ddbd

	column campaign_id
		dataType: string
		lineageTag: 7b2f70a0-0e1f-59bb-be81-6b0502ac80d8
		summarizeBy: none
		sourceColumn: campaign_id

	column type
		dataType: string
		lineageTag: e88b7acc-bb20-5604-8ec9-aa58bb90c357
		summarizeBy: none
		sourceColumn: type

	column region
		dataType: string
		lineageTag: 59be4895-9f5f-5355-b3ba-045313f8a366
		summarizeBy: none
