model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "campaign_scorecard", "funnel_by_region_channel", "cohort_matrix_weekly", "retention_by_channel_month", "_Measures"]

ref table campaign_scorecard
ref table funnel_by_region_channel
ref table cohort_matrix_weekly
ref table retention_by_channel_month
ref table _Measures
